+// Opt-in LES storage on Jetson: CPU writes expert slots, CUDA computes from
+// the same allocation. Keep generic CUDA_Host support and integrated unchanged.
+static bool ggml_backend_cuda_les_host_addressable(ggml_backend_buffer_type_t) {
+    return true;
+}
+
+static ggml_backend_buffer_t ggml_backend_cuda_les_alloc_buffer(ggml_backend_buffer_type_t buft, size_t size) {
+    auto * bc = (ggml_backend_cuda_buffer_type_context *) buft->context;
+    ggml_cuda_set_device(bc->device);
+    void * host = nullptr;
+    cudaError_t err = cudaHostAlloc(&host, size, cudaHostAllocMapped);
+    if (err != cudaSuccess) {
+        (void) cudaGetLastError();
+        GGML_LOG_ERROR("%s: cudaHostAlloc: %s\n", __func__, cudaGetErrorString(err));
+        return nullptr;
+    }
+    void * device = nullptr;
+    err = cudaHostGetDevicePointer(&device, host, 0);
+    if (err != cudaSuccess || device != host) {
+        (void) cudaGetLastError();
+        CUDA_CHECK(cudaFreeHost(host));
+        GGML_LOG_ERROR("%s: LES requires identical CPU and CUDA addresses\n", __func__);
+        return nullptr;
+    }
+    auto * ctx = new ggml_backend_cuda_buffer_context(bc->device, host, true);
+    return ggml_backend_buffer_init(buft, ggml_backend_cuda_buffer_interface, ctx, size);
+}
+
+static ggml_backend_buffer_type_t ggml_backend_cuda_les_alloc_only(size_t device) {
+    const char * enable = std::getenv("GGML_CUDA_LES_MAPPED");
+    if (!enable || strcmp(enable, "1") != 0 || device >= (size_t) ggml_backend_cuda_get_device_count()) {
+        return nullptr;
+    }
+    cudaDeviceProp prop;
+    CUDA_CHECK(cudaGetDeviceProperties(&prop, (int) device));
+    if (!prop.integrated || !prop.canMapHostMemory || !prop.unifiedAddressing) {
+        return nullptr;
+    }
+    static std::mutex mutex;
+    std::lock_guard<std::mutex> lock(mutex);
+    static ggml_backend_buffer_type types[GGML_CUDA_MAX_DEVICES] = {};
+    auto & type = types[device];
+    if (!type.context) {
+        type = *ggml_backend_cuda_buffer_type((int) device);
+        type.iface.alloc_buffer = ggml_backend_cuda_les_alloc_buffer;
+        type.iface.is_host_addressable = ggml_backend_cuda_les_host_addressable;
+        type.context = new ggml_backend_cuda_buffer_type_context{
+            (int) device, GGML_CUDA_NAME + std::to_string(device) + "_LES_Mapped"};
+        GGML_LOG_INFO("LES: using mapped CUDA expert storage on %s\n", prop.name);
+    }
+    return &type;
 }
 
