diff --git a/tools/server/CMakeLists.txt b/tools/server/CMakeLists.txt
index 7b4d40d..a8b6051 100644
--- a/tools/server/CMakeLists.txt
+++ b/tools/server/CMakeLists.txt
@@ -74,3 +74,34 @@ target_compile_features(${TARGET_VOXCPM2} PRIVATE cxx_std_17)
 target_include_directories(${TARGET_VOXCPM2} PRIVATE ${CMAKE_SOURCE_DIR})
 target_include_directories(${TARGET_VOXCPM2} PRIVATE ${CMAKE_SOURCE_DIR}/vendor/cpp-httplib)
 target_include_directories(${TARGET_VOXCPM2} PRIVATE ${CMAKE_SOURCE_DIR}/vendor)
+
+
+# llama-les-server: the standard llama.cpp server (tools/server/server.cpp).
+# Upstream removed this target in this branch; restoring it is required for
+# DSpark/DFlash speculative decoding, whose ctx_other link lives in
+# server-context.cpp. llama-cli never creates a draft context at all.
+set(TARGET_LES llama-les-server)
+
+add_executable(${TARGET_LES}
+    main.cpp
+    server.cpp
+    server-http.cpp
+    server-models.cpp
+    server-omni.cpp
+)
+install(TARGETS ${TARGET_LES} RUNTIME)
+
+target_link_libraries(${TARGET_LES} PRIVATE server-context llama-common omni mtmd cpp-httplib ${CMAKE_THREAD_LIBS_INIT})
+if (LLAMA_OPENSSL AND OpenSSL_FOUND)
+    target_link_libraries(${TARGET_LES} PRIVATE OpenSSL::SSL OpenSSL::Crypto)
+    target_compile_definitions(${TARGET_LES} PRIVATE CPPHTTPLIB_OPENSSL_SUPPORT)
+endif()
+target_compile_features(${TARGET_LES} PRIVATE cxx_std_17)
+target_include_directories(${TARGET_LES} PRIVATE ${CMAKE_SOURCE_DIR})
+target_include_directories(${TARGET_LES} PRIVATE ${CMAKE_SOURCE_DIR}/vendor/cpp-httplib)
+target_include_directories(${TARGET_LES} PRIVATE ${CMAKE_SOURCE_DIR}/vendor)
+target_include_directories(${TARGET_LES} PRIVATE ${CMAKE_CURRENT_SOURCE_DIR}/../omni)
+target_include_directories(${TARGET_LES} PRIVATE ${CMAKE_BINARY_DIR}/tools/ui)
+target_link_libraries(${TARGET_LES} PRIVATE llama-ui)
+target_include_directories(${TARGET_LES} PRIVATE ${CMAKE_CURRENT_SOURCE_DIR}/../omni/voxcpm2)
+target_link_libraries(${TARGET_LES} PRIVATE voxcpm2_runtime)
