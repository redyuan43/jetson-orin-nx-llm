+        if (model_dft == NULL) {
+            LOG_ERR("%s: failed to load draft model '%s'\n", __func__, params_dft.model.path.c_str());
+            return;
+        }
+        pimpl->model_dft.reset(model_dft);
+
+        auto cparams_dft = common_context_params_to_llama(params_dft);
+        cparams_dft.n_rs_seq  = 0;
+        cparams_dft.ctx_other = lctx;
+        llama_context * ctx_dft = llama_init_from_model(model_dft, cparams_dft);
+        if (ctx_dft == NULL) {
+            LOG_ERR("%s: failed to create draft context\n", __func__);
+            return;
+        }
+        pimpl->context_dft.reset(ctx_dft);
+
+        params_spec.ctx_tgt = lctx;
+        params_spec.ctx_dft = ctx_dft;
+        LOG_INF("%s: DSpark draft context ready (ctx_other linked)\n", __func__);
+    }
 }
 
