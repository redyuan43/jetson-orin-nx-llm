{
  "openapi": "3.1.0",
  "info": {
    "title": "nx5 Qwen / MiniCPM SSD 互斥推理",
    "version": "runtime-source-sha256"
  },
  "servers": [
    {
      "url": "http://nx5.taild500c8.ts.net:18347"
    }
  ],
  "security": [
    {
      "BearerAuth": []
    }
  ],
  "paths": {
    "/v1/jobs": {
      "post": {
        "summary": "提交指定模型；统一单任务准入和中央GPU独占租约",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Submit"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "已受理，请查询status_url",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Receipt"
                }
              }
            }
          },
          "400": {
            "description": "字段、档位或输出限制无效",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "需要服务专用Bearer Token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "设备任务忙或request_id冲突",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "413": {
            "description": "请求体超过2MiB",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/jobs/{job_id}": {
      "get": {
        "summary": "查询原任务及最终文字结果",
        "parameters": [
          {
            "name": "job_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^op_[a-f0-9]{32}$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "任务状态；仅succeeded为成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Job"
                }
              }
            }
          },
          "401": {
            "description": "需要服务专用Bearer Token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "没有该任务",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/models": {
      "get": {
        "summary": "发现两个可按需加载的模型，不加载权重",
        "responses": {
          "200": {
            "description": "OpenAI model list",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Models"
                }
              }
            }
          },
          "401": {
            "description": "需要专用Bearer",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChatError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/chat/completions": {
      "post": {
        "summary": "互斥按需加载；OpenAI兼容纯文本多轮聊天/SSE",
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_.-]{1,100}$"
            },
            "description": "重用同一键和完整推理内容恢复原任务，不重跑。无键每次新任务。"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChatRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "JSON完成；或SSE role/content delta、最终finish、可选usage、[DONE]；等待时注释心跳，失败时error。断线不取消后台推理。",
            "headers": {
              "X-Job-ID": {
                "schema": {
                  "type": "string"
                },
                "description": "认证GET /v1/jobs/{id}恢复原任务"
              },
              "X-Request-ID": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChatCompletion"
                }
              },
              "text/event-stream": {
                "schema": {
                  "type": "string"
                },
                "example": "data: {\"id\":\"chatcmpl-example\",\"object\":\"chat.completion.chunk\",\"created\":0,\"model\":\"qwen36-128k\",\"choices\":[{\"index\":0,\"delta\":{\"content\":\"你好\"},\"finish_reason\":null}]}\n\n"
              }
            }
          },
          "400": {
            "description": "无效或不支持的参数；上下文超限",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChatError"
                }
              }
            }
          },
          "401": {
            "description": "需要专用Bearer",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChatError"
                }
              }
            }
          },
          "404": {
            "description": "model不存在",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChatError"
                }
              }
            }
          },
          "409": {
            "description": "Idempotency-Key推理内容冲突",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChatError"
                }
              }
            }
          },
          "413": {
            "description": "超过2MiB",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChatError"
                }
              }
            }
          },
          "429": {
            "description": "device_job_busy；同一准入槽位，不排队",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChatError"
                }
              }
            }
          },
          "503": {
            "description": "推理失败或原任务状态未知，先查原任务",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChatError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "nx5-ssd-llm专用Bearer令牌；仅Tailnet。由nx5管理员安全提供。"
      }
    },
    "schemas": {
      "Submit": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "request_id",
          "profile",
          "prompt"
        ],
        "properties": {
          "request_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.-]{1,100}$"
          },
          "prompt": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500000
          },
          "profile": {
            "type": "string",
            "enum": [
              "qwen36-128k",
              "minicpm-64k"
            ]
          },
          "max_tokens": {
            "type": "integer",
            "minimum": 1,
            "maximum": 7680,
            "default": 2048
          }
        },
        "description": "必须指定模型档位。相同request_id和规范化请求只返回原任务；进行中拒绝其他新任务。输入与输出之和须适配所选上下文；当前仅文本。"
      },
      "Receipt": {
        "type": "object",
        "required": [
          "id",
          "status",
          "status_url"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "waiting",
              "running",
              "succeeded",
              "failed",
              "unknown"
            ]
          },
          "status_url": {
            "type": "string"
          }
        }
      },
      "Job": {
        "type": "object",
        "required": [
          "id",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "request_id": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "waiting",
              "running",
              "succeeded",
              "failed",
              "unknown"
            ]
          },
          "error": {
            "type": "string"
          },
          "result": {
            "type": "object",
            "properties": {
              "text": {
                "type": "string"
              },
              "profile": {
                "type": "string"
              },
              "context_capacity": {
                "type": "integer"
              },
              "input_tokens": {
                "type": "integer"
              },
              "output_tokens": {
                "type": "integer"
              },
              "finish_reason": {
                "type": "string",
                "enum": [
                  "stop",
                  "length"
                ]
              },
              "model_loaded_after": {
                "type": "boolean"
              },
              "lease_status": {
                "type": "string",
                "enum": [
                  "released"
                ]
              },
              "prefill_s": {
                "type": "number"
              },
              "generation_s": {
                "type": "number"
              },
              "decode_tps": {
                "type": "number"
              },
              "process_wall_s": {
                "type": "number"
              },
              "min_available_mib": {
                "type": "number"
              }
            },
            "required": [
              "text",
              "profile",
              "context_capacity",
              "input_tokens",
              "output_tokens",
              "finish_reason",
              "model_loaded_after",
              "lease_status",
              "prefill_s",
              "generation_s",
              "decode_tps",
              "process_wall_s",
              "min_available_mib"
            ]
          },
          "profile": {
            "type": "string"
          },
          "created_at": {
            "type": "number"
          },
          "started_at": {
            "type": "number"
          },
          "finished_at": {
            "type": "number"
          }
        }
      },
      "Error": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "string"
          }
        }
      },
      "ChatError": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "object",
            "required": [
              "message",
              "type",
              "code"
            ],
            "properties": {
              "message": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "type": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "param": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "code": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        }
      },
      "ChatRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "model",
          "messages"
        ],
        "properties": {
          "model": {
            "type": "string",
            "enum": [
              "qwen36-128k",
              "minicpm-64k"
            ]
          },
          "messages": {
            "type": "array",
            "minItems": 1,
            "maxItems": 1024,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "role"
              ],
              "properties": {
                "role": {
                  "type": "string",
                  "enum": [
                    "system",
                    "user",
                    "assistant",
                    "tool"
                  ]
                },
                "content": {
                  "oneOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "type",
                          "text"
                        ],
                        "properties": {
                          "type": {
                            "const": "text"
                          },
                          "text": {
                            "type": "string"
                          }
                        }
                      }
                    },
                    {
                      "type": "null",
                      "description": "Only assistant tool-call messages may omit content or use null."
                    }
                  ]
                },
                "reasoning_content": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "description": "Optional assistant-only reasoning text for round-tripping. Model templates decide whether earlier reasoning is retained."
                },
                "tool_call_id": {
                  "type": "string",
                  "maxLength": 128
                },
                "name": {
                  "type": "string",
                  "maxLength": 128
                },
                "tool_calls": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 128,
                  "items": {
                    "$ref": "#/components/schemas/ToolCall"
                  }
                }
              }
            },
            "description": "system仅首条；末条为user或tool；工具结果必须匹配未完成调用ID且全部回传；文本与思考合计1–500000字符，完整消息和工具schema JSON不超过1500000字符。"
          },
          "stream": {
            "type": "boolean",
            "default": false
          },
          "stream_options": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": false,
            "properties": {
              "include_usage": {
                "type": "boolean"
              }
            }
          },
          "max_tokens": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1,
            "maximum": 7680,
            "default": 2048
          },
          "max_completion_tokens": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1,
            "maximum": 7680
          },
          "seed": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0,
            "maximum": 4294967295
          },
          "stop": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              {
                "type": "array",
                "maxItems": 4,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                }
              }
            ]
          },
          "n": {
            "const": 1
          },
          "tools": {
            "type": [
              "array",
              "null"
            ],
            "maxItems": 128,
            "items": {
              "$ref": "#/components/schemas/ToolDefinition"
            }
          },
          "tool_choice": {
            "oneOf": [
              {
                "enum": [
                  null,
                  "auto",
                  "none",
                  "required"
                ]
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "type",
                  "function"
                ],
                "properties": {
                  "type": {
                    "const": "function"
                  },
                  "function": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "name"
                    ],
                    "properties": {
                      "name": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            ]
          },
          "response_format": {
            "enum": [
              null,
              {
                "type": "text"
              }
            ]
          },
          "user": {
            "type": "string",
            "maxLength": 200
          },
          "temperature": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 2
          },
          "top_p": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 1
          },
          "presence_penalty": {
            "type": [
              "number",
              "null"
            ],
            "minimum": -2,
            "maximum": 2
          },
          "frequency_penalty": {
            "type": [
              "number",
              "null"
            ],
            "minimum": -2,
            "maximum": 2
          },
          "enable_thinking": {
            "type": "boolean",
            "default": false,
            "description": "Enable model thinking for this request. Omitted/false keeps the reference non-thinking mode. WebUI exposes a per-model choice and defaults to enabled."
          },
          "parallel_tool_calls": {
            "type": "boolean",
            "default": true
          }
        }
      },
      "Usage": {
        "type": "object",
        "required": [
          "prompt_tokens",
          "completion_tokens",
          "total_tokens"
        ],
        "properties": {
          "prompt_tokens": {
            "type": "integer",
            "minimum": 0
          },
          "completion_tokens": {
            "type": "integer",
            "minimum": 0
          },
          "total_tokens": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "ChatCompletion": {
        "type": "object",
        "required": [
          "id",
          "object",
          "created",
          "model",
          "choices",
          "usage"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "object": {
            "const": "chat.completion"
          },
          "created": {
            "type": "integer"
          },
          "model": {
            "type": "string"
          },
          "usage": {
            "$ref": "#/components/schemas/Usage"
          },
          "choices": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "index",
                "message",
                "finish_reason"
              ],
              "properties": {
                "index": {
                  "const": 0
                },
                "message": {
                  "type": "object",
                  "required": [
                    "role",
                    "content"
                  ],
                  "properties": {
                    "role": {
                      "const": "assistant"
                    },
                    "content": {
                      "type": "string"
                    },
                    "reasoning_content": {
                      "type": "string",
                      "description": "Model reasoning text, separate from the final answer. SSE uses delta.reasoning_content."
                    },
                    "tool_calls": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/ToolCall"
                      },
                      "description": "SSE sends indexed delta.tool_calls fragments. The caller validates/executes tools and submits role=tool results."
                    }
                  }
                },
                "finish_reason": {
                  "enum": [
                    "stop",
                    "length",
                    "tool_calls"
                  ]
                },
                "logprobs": {
                  "type": "null"
                }
              }
            }
          },
          "timings": {
            "$ref": "#/components/schemas/Timings"
          }
        }
      },
      "Models": {
        "type": "object",
        "required": [
          "object",
          "data"
        ],
        "properties": {
          "object": {
            "const": "list"
          },
          "data": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "object",
                "created",
                "owned_by",
                "context_window"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "object": {
                  "const": "model"
                },
                "created": {
                  "type": "integer"
                },
                "owned_by": {
                  "const": "nx5"
                },
                "context_window": {
                  "type": "integer"
                }
              }
            }
          }
        }
      },
      "Timings": {
        "type": "object",
        "description": "Measured successful-request timings. All durations are seconds. Streamed once with the final usage chunk when include_usage=true.",
        "properties": {
          "decode_tps": {
            "type": "number",
            "minimum": 0,
            "description": "Engine decode tokens per second, excluding model loading and prefill."
          },
          "generation_s": {
            "type": "number",
            "minimum": 0,
            "description": "Engine generation elapsed seconds."
          },
          "prefill_s": {
            "type": "number",
            "minimum": 0,
            "description": "Engine prompt processing seconds."
          },
          "process_wall_s": {
            "type": "number",
            "minimum": 0,
            "description": "Inference process wall seconds."
          },
          "total_s": {
            "type": "number",
            "minimum": 0,
            "description": "Original request admission through completion, including loading and lease lifecycle; excludes client network/rendering."
          }
        }
      },
      "ToolFunction": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.:-]{1,128}$"
          },
          "description": {
            "type": "string"
          },
          "parameters": {
            "type": "object"
          },
          "strict": {
            "type": "boolean"
          }
        }
      },
      "ToolDefinition": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "function"
        ],
        "properties": {
          "type": {
            "const": "function"
          },
          "function": {
            "$ref": "#/components/schemas/ToolFunction"
          }
        }
      },
      "ToolCall": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "type",
          "function"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.:-]{1,128}$"
          },
          "type": {
            "const": "function"
          },
          "function": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "arguments"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "arguments": {
                "type": "string",
                "description": "JSON-encoded function arguments"
              }
            }
          }
        }
      }
    }
  }
}
