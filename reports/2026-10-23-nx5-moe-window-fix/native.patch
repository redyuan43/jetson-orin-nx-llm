diff --git a/tests/test-moe-slot-state.cpp b/tests/test-moe-slot-state.cpp
new file mode 100644
index 0000000..38d83f4
--- /dev/null
+++ b/tests/test-moe-slot-state.cpp
@@ -0,0 +1,95 @@
+#include "../src/llama-moe-slot-state.h"
+
+#include <cstdint>
+#include <vector>
+
+int main() {
+    constexpr int32_t bank_capacity = 64;
+    constexpr int32_t window_start = 0;
+    constexpr int32_t window_width = 176;
+    constexpr int32_t n_experts = 256;
+    constexpr int32_t free_slot = -1;
+    constexpr int32_t pending_slot = -2;
+
+    std::vector<int32_t> slot_to_expert(bank_capacity, free_slot);
+    std::vector<uint64_t> slot_age(bank_capacity, 0);
+
+    llama_moe_slot_state::resize_metadata(
+        slot_to_expert, slot_age, bank_capacity, window_start, window_width, free_slot);
+
+    const size_t window_end = (size_t) (window_start + window_width);
+    if (slot_to_expert.size() != window_end || slot_age.size() != window_end) {
+        return 1;
+    }
+    for (size_t i = bank_capacity; i < window_end; ++i) {
+        if (slot_to_expert[i] != free_slot || slot_age[i] != 0) {
+            return 2;
+        }
+    }
+
+    // A cold cache must scan through candidate 68 even though the prefill bank is only 64.
+    for (int32_t expert = 0; expert <= 68; ++expert) {
+        int32_t slot = -1;
+        for (int32_t candidate = window_start; candidate < window_start + window_width; ++candidate) {
+            if (slot_to_expert[(size_t) candidate] == free_slot) {
+                slot = candidate;
+                break;
+            }
+        }
+        if (slot != expert) {
+            return 3;
+        }
+        slot_to_expert[(size_t) slot] = expert;
+        slot_age[(size_t) slot] = (uint64_t) expert + 1;
+    }
+    if (slot_to_expert[68] != 68) {
+        return 4;
+    }
+
+    // Fill the decode window, then exercise both eviction passes with expert 255.
+    for (int32_t expert = 69; expert < window_width; ++expert) {
+        slot_to_expert[(size_t) expert] = expert;
+        slot_age[(size_t) expert] = (uint64_t) expert + 1;
+    }
+    std::vector<uint8_t> requested(n_experts, 0);
+    requested[255] = 1;
+    int32_t selected = -1;
+    uint64_t oldest = UINT64_MAX;
+    for (int32_t candidate = window_start; candidate < window_start + window_width; ++candidate) {
+        const int32_t resident = slot_to_expert[(size_t) candidate];
+        if (resident == pending_slot) {
+            continue;
+        }
+        if (!requested[(size_t) resident] && slot_age[(size_t) candidate] < oldest) {
+            oldest = slot_age[(size_t) candidate];
+            selected = candidate;
+        }
+    }
+    if (selected != 0) {
+        return 5;
+    }
+    slot_to_expert[(size_t) selected] = 255;
+
+    // Transition to prefill clears all non-pending map entries, including decode-only slots.
+    slot_to_expert[70] = pending_slot;
+    for (auto & resident : slot_to_expert) {
+        if (resident != pending_slot) {
+            resident = free_slot;
+        }
+    }
+    for (int32_t candidate = 0; candidate < bank_capacity; ++candidate) {
+        if (slot_to_expert[(size_t) candidate] != free_slot) {
+            return 6;
+        }
+    }
+    for (size_t candidate = bank_capacity; candidate < window_end; ++candidate) {
+        if (candidate == 70) {
+            if (slot_to_expert[candidate] != pending_slot) {
+                return 7;
+            }
+        } else if (slot_to_expert[candidate] != free_slot) {
+            return 8;
+        }
+    }
+    return 0;
+}
