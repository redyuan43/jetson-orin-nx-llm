diff --git a/src/llama-moe-slot-state.h b/src/llama-moe-slot-state.h
new file mode 100644
index 0000000..ed52326
--- /dev/null
+++ b/src/llama-moe-slot-state.h
@@ -0,0 +1,28 @@
+#pragma once
+
+#include <algorithm>
+#include <cstddef>
+#include <cstdint>
+#include <vector>
+
+namespace llama_moe_slot_state {
+
+inline std::size_t tracking_capacity(int32_t bank_capacity, int32_t window_start, int32_t window_width) {
+    const int64_t bank_end = std::max<int64_t>(0, bank_capacity);
+    const int64_t window_end = std::max<int64_t>(0, (int64_t) window_start + window_width);
+    return (std::size_t) std::max(bank_end, window_end);
+}
+
+inline void resize_metadata(
+        std::vector<int32_t> & slot_to_expert,
+        std::vector<uint64_t> & slot_age,
+        int32_t bank_capacity,
+        int32_t window_start,
+        int32_t window_width,
+        int32_t free_slot) {
+    const std::size_t required = tracking_capacity(bank_capacity, window_start, window_width);
+    slot_to_expert.resize(required, free_slot);
+    slot_age.resize(required, 0);
+}
+
+} // namespace llama_moe_slot_state
