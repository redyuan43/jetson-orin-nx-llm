<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Pelican on a Bicycle</title>
    <style>
        body {
            margin: 0;
            padding: 0;
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
            background-color: #f0f0f0;
            overflow: hidden;
        }
        svg {
            width: 800px;
            height: 600px;
            background: linear-gradient(to bottom, #87CEEB 0%, #E0F7FA 100%);
            border: 1px solid #ccc;
            box-shadow: 0 4px 8px rgba(0,0,0,0.1);
        }
        
        /* Wheel Rotation */
        .wheel {
            transform-origin: center;
            animation: rotateWheel 2s linear infinite;
        }
        @keyframes rotateWheel {
            from { transform: rotate(0deg); }
            to { transform: rotate(360deg); }
        }

        /* Pedal Rotation */
        .pedal-crank {
            transform-origin: 400px 450px;
            animation: rotateCrank 2s linear infinite;
        }
        @keyframes rotateCrank {
            from { transform: rotate(0deg); }
            to { transform: rotate(360deg); }
        }

        /* Pelican Bobbing */
        .pelican-body {
            animation: bob 0.5s ease-in-out infinite alternate;
        }
        @keyframes bob {
            from { transform: translateY(0); }
            to { transform: translateY(-5px); }
        }

        /* Wing Flapping */
        .wing {
            transform-origin: 380px 250px;
            animation: flapWing 0.5s ease-in-out infinite alternate;
        }
        @keyframes flapWing {
            from { transform: rotate(0deg); }
            to { transform: rotate(-10deg); }
        }

        /* Leg Movement (attached to pedal crank logic visually) */
        .leg-front {
            transform-origin: 380px 300px;
            animation: moveLegFront 2s linear infinite;
        }
        .leg-back {
            transform-origin: 420px 300px;
            animation: moveLegBack 2s linear infinite;
        }
        
        @keyframes moveLegFront {
            0% { transform: rotate(0deg); }
            25% { transform: rotate(90deg); }
            50% { transform: rotate(180deg); }
            75% { transform: rotate(270deg); }
            100% { transform: rotate(360deg); }
        }
        @keyframes moveLegBack {
            0% { transform: rotate(180deg); }
            25% { transform: rotate(270deg); }
            50% { transform: rotate(360deg); }
            75% { transform: rotate(450deg); }
            100% { transform: rotate(540deg); }
        }
    </style>
</head>
